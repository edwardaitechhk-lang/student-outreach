# Notion Integration
# 去 https://notion.so/my-integrations → New integration
# Copy 個 "Internal Integration Secret"，paste 落面
NOTION_TOKEN=ntn_your_token_here

# Notion Database ID
# 你個 CRM database 個 URL 尾段（去掉 dash）
# e.g. https://notion.so/92b9c13bd4d546f7b1e706cdb3887083?v=xxx → 92b9c13bd4d546f7b1e706cdb3887083
NOTION_DB_ID=92b9c13bd4d546f7b1e706cdb3887083

# Product filter (optional) — Notion CRM 嘅「產品」欄位值
# 留空 = 所有學員都會 fetch
PRODUCT_FILTER=12 Agent 課程
